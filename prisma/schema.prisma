generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum EventCategory {
  CONFERENCE
  COMSYS_HACKATHONS
  OUTREACH_ACTIVITIES
  FOUNDATION_DAY
  UPCOMING_EVENTS
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum GalleryUse {
  HOME
  OVERVIEW
  EVENT
  FINISHING_SCHOOL
}

enum GallerySubUse {
  ABOUT_US
  GALLERY
  SLIDER_IMAGE
}

model AboutHero {
  id          String   @id @default(cuid())
  eyebrow     String?
  title       String
  description String?
  published   Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("about_hero")
}

model VisionMission {
  id    String @id @default(cuid())
  type  String // "vision" | "mission"
  title String
  body  String

  @@map("vision_mission")
}

model HistoryIntro {
  id    String @id @default(cuid())
  intro String

  @@map("history_intro")
}

model HistoryMilestone {
  id    String @id @default(cuid())
  year  String
  title String
  body  String
  order Int    @default(0)

  @@map("history_milestones")
  @@index([order])
}

model LeadershipMessage {
  id          String @id @default(cuid())
  role        String // "president" | "secretary"
  name        String
  designation String?
  message     String
  photoUrl    String?
  order       Int    @default(0)

  @@map("leadership_messages")
}

model Trustee {
  id          String @id @default(cuid())
  name        String
  designation String?
  photoUrl    String?
  bio         String?
  order       Int    @default(0)

  @@map("trustees")
  @@index([order])
}

model ExecutiveMember {
  id          String @id @default(cuid())
  name        String
  designation String?
  photoUrl    String?
  order       Int    @default(0)

  @@map("executive_committee")
  @@index([order])
}

model CoreValue {
  id          String @id @default(cuid())
  icon        String // key into your lib/iconMap.js — "target" | "eye" | "heart" etc.
  title       String
  description String
  order       Int    @default(0)

  @@map("core_values")
  @@index([order])
}

model RoadmapSection {
  id    String @id @default(cuid())
  title String

  @@map("roadmap_section")
}

model RoadmapMilestone {
  id     String  @id @default(cuid())
  year   String
  title  String
  body   String
  status String? // e.g. "In Progress", "Completed", "Planned"
  order  Int     @default(0)

  @@map("roadmap_milestones")
  @@index([order])
}

model User {
  id                String    @id @default(cuid())
  role              Role?
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  organization      String?
  phoneNumber       String?   @map("phone_number")
  email             String    @unique
  password          String
  isActive          Boolean   @default(true)
  emailVerified     Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastLogin         DateTime? @map("last_login")
     
  // Add these fields for email verification
  emailVerificationToken String?   @map("email_verification_token")
  emailVerificationExpiry DateTime? @map("email_verification_expiry")
     
  // Relations
  coursesCreated       Courses[]       @relation("CoursesCreatedBy")
  member               Member?         @relation("UserMember")
  newsCreated          News[]          @relation("NewsCreatedBy")
  foundationDayCreated FoundationDay[] @relation("FoundationDayCreatedBy")
  createdMembers       Member[]        @relation("MemberCreatedBy") 
     
  @@map("users")
}

model Gallery {
  id          String   @id @default(cuid())
  photoUrl    String
  heading     String
  description String?
  category    String   @default("conference") // "conference" | "outreach" | "awards"
  time        DateTime @default(now())
  active      Boolean  @default(true)

  @@map("gallery")
  @@index([time])
  @@index([active])
  @@index([category])
}

// Courses model
model Courses {
  id          String   @id @default(cuid())
  name        String
  duration    String
  imgUrl      String   @map("img_url")
  description String?
  enrollUrl   String?  @map("enroll_url")
  isActive    Boolean  @default(true)
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  createdBy   User     @relation("CoursesCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("courses")
}

// Missions model
model Missions {
  id          String   @id @default(cuid())
  heading     String
  description String
  icon        String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("missions")
}

// Members model - only for ADMIN/SUPER_ADMIN users
model Member {
  id          String  @id @default(cuid())
  name        String  // Computed from User's firstName + lastName
  imgUrl      String? @map("img_url")
  bio         String?
  designation String?
  email       String  @unique
  phoneNo     String? @map("phone_no")
  isActive    Boolean @default(true)
  role        Role
  urlBiodata  Json?   @map("url_biodata") // JSON for social media links
  userId      String  @unique @map("user_id")
  createdById String? @map("created_by_id") // Add this field
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user        User    @relation("UserMember", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User?   @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("members")
}

// Events model
model Events {
  id          String        @id @default(cuid())
  title       String
  location    String
  category    EventCategory
  year        Int
  description String?
  url         String?       // Single URL field for the event
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("events")
}

// News model
model News {
  id          String   @id @default(cuid())
  title       String
  imgUrl      String?  @map("img_url")
  description String
  urlNews     String?  @map("url_news")
  isActive    Boolean  @default(true)
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  createdBy   User     @relation("NewsCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("news")
}

// Foundation Day model
model FoundationDay {
  id          String   @id @default(cuid())
  year        Int      @unique
  description String
  imgUrl      String?  @map("img_url")
  isActive    Boolean  @default(true)
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  createdBy   User     @relation("FoundationDayCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@map("foundation_day")
}

// Contact Us model
model ContactUs {
  id               String   @id @default(cuid())
  fullName         String   @map("full_name")
  email            String   // Cannot be null as requested
  phoneNumber      String?  @map("phone_number")
  organizationName String?  @map("organization_name")
  subject          String?
  message          String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("contact_us")
}